/* BYTE/ADDRESS ARITHMETIC, ARRAYS, POINTERS, AND PROCEDURES. */
100H:
/* CP/M BDOS ENTRY: FUNCTION IN C, PARAMETER IN DE. */
MON1: PROCEDURE(F,A);
    DECLARE F BYTE, A ADDRESS;
    GO TO 5;
END MON1;
PUTC: PROCEDURE(C);
    DECLARE C BYTE;
    CALL MON1(2,C);
END PUTC;
CRLF: PROCEDURE;
    CALL PUTC(13); CALL PUTC(10);
END CRLF;
CHECK: PROCEDURE(TEST);
    DECLARE TEST BYTE;
    IF NOT TEST THEN DO;
        CALL PUTC('F'); CALL CRLF; CALL MON1(0,0);
    END;
END CHECK;
DECLARE (X,Y) ADDRESS, (A,B,I) BYTE;
DECLARE VALUES(16) BYTE;
DECLARE P ADDRESS, VALUE BASED P BYTE;
X=12345; Y=321;
CALL CHECK(X+Y=12666);
CALL CHECK(X-Y=12024);
CALL CHECK(X*Y=30585);
CALL CHECK(X/Y=38);
CALL CHECK(X MOD Y=147);
CALL CHECK(SHR(X,3)=1543);
CALL CHECK(SHL(Y,3)=2568);
A=255; B=2;
CALL CHECK(A+B=1);
DO I=0 TO LAST(VALUES);
    VALUES(I)=I*I;
END;
P=.VALUES+15;
CALL CHECK(VALUE=225);
CALL PUTC('O'); CALL PUTC('K'); CALL CRLF;
CALL MON1(0,0);
