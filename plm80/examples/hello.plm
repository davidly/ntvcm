/* HELLO FOR INTEL PL/M-80 4.1 ON CP/M. */
100H:
/* CP/M BDOS ENTRY: FUNCTION IN C, PARAMETER IN DE. */
MON1: PROCEDURE(F,A);
    DECLARE F BYTE, A ADDRESS;
    GO TO 5;
END MON1;
PUTC: PROCEDURE(C);
    DECLARE C BYTE;
    CALL MON1(2,C);
END PUTC;
CRLF: PROCEDURE;
    CALL PUTC(13); CALL PUTC(10);
END CRLF;
DECLARE MSG(18) BYTE INITIAL ('HELLO, PL/M-80', 33, 13, 10, '$');
CALL MON1(9,.MSG);
CALL MON1(0,0);
